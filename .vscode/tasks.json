{
  //===-------------------------------------------------------------------------===//
  // Build tasks for the yabai fork
  //
  // CMake tasks use the presets in CMakePresets.json; each preset builds into
  // build/<preset>/ and points the root compile_commands.json at itself.
  // The makefile task reproduces the upstream build in bin/ for comparison.
  //
  // Inputs:
  //   ${input:preset} - Debug, Release, ASan/UBSan or TSan/UBSan preset
  //===-------------------------------------------------------------------------===//
  "version": "2.0.0",

  "tasks": [
    //===------------------------------- CMAKE ---------------------------------===//
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "${input:preset}"],
      "problemMatcher": [],
      "detail": "Configure the selected preset and relink compile_commands.json"
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake --preset ${input:preset} > /dev/null && cmake --build --preset ${input:preset}",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Configure if needed and build yabai, the payload and the loader"
    },
    {
      "label": "CMake: Clean & Reconfigure",
      "type": "shell",
      "command": "rm -rf build/${input:preset} && cmake --preset ${input:preset}",
      "problemMatcher": [],
      "detail": "Remove the preset build directory and configure it again"
    },

    //===------------------------------ UPSTREAM -------------------------------===//
    {
      "label": "Make: Build (upstream makefile)",
      "type": "shell",
      "command": "make",
      "args": ["install"],
      "problemMatcher": ["$gcc"],
      "detail": "Optimised build with the upstream makefile into bin/yabai"
    },

    //===-------------------------------- RUN ----------------------------------===//
    {
      "label": "Run: yabai --version",
      "type": "shell",
      "command": "build/${input:preset}/bin/yabai",
      "args": ["--version"],
      "problemMatcher": [],
      "detail": "Smoke test of the selected preset build"
    }
  ],

  "inputs": [
    {
      "id": "preset",
      "type": "pickString",
      "description": "CMake preset",
      "options": ["debug", "release", "sanitize", "thread-sanitize"],
      "default": "debug"
    }
  ]
}
